# =============================================
# SentinelOps - .gitignore
# =============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# ---------------------------------------------
# Data & models
# ---------------------------------------------
# datasets/, data/processed/, data/reference/ and models/ are tracked by DVC.
# DVC writes .gitignore entries inside those directories itself and commits
# the small .dvc pointer files, so they are deliberately NOT listed here --
# listing them would hide the pointers and make a fresh clone unrunnable.

# Raw CSV release: not consumed by the pipeline (Parquet is), demo input only.
datasets/CIC-IDS2017-csv/

# Intermediate stage output; regenerated by `dvc repro prepare_data`.
data/interim/

# ---------------------------------------------
# MLflow
# ---------------------------------------------
# The tracking store is a local artifact of running the pipeline. The exported
# reports/mlops_state.json is what the API serves, and that IS committed.
mlflow.db
mlflow.db-journal
mlartifacts/
mlruns/

# ---------------------------------------------
# Reports & metrics
# ---------------------------------------------
# Committed on purpose: the deployed container serves the MLOps control panel
# straight from these files and has no MLflow or DVC available at runtime.
#   reports/mlops_state.json
#   reports/governance_log.jsonl
#   reports/drift_summary.json
#   metrics/*.json
# Only bulky regenerable plots are excluded.
reports/*.png

# ---------------------------------------------
# Frontend
# ---------------------------------------------
frontend/node_modules/
frontend/dist/

# ---------------------------------------------
# Pytest / coverage
# ---------------------------------------------
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------
# Temp / scratch
# ---------------------------------------------
*.log
*.tmp
*.temp
phase1_run.txt
pip_install.txt
test_results*.txt
inspect_*.txt
inspect_*.py

# Secrets
.env
*.env
secrets.yaml
